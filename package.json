{
  "name": "fluxdown-monorepo",
  "version": "0.5.0",
  "private": true,
  "description": "Extensible, headless-capable, reactive Markdown rendering for LLM streaming scenarios.",
  "keywords": [
    "hast",
    "headless",
    "llm",
    "markdown",
    "react",
    "streaming"
  ],
  "homepage": "https://hexmora.github.io/fluxdown/",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git"
  },
  "type": "module",
  "scripts": {
    "build": "moon run :build",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "commitlint:edit": "commitlint --edit",
    "format": "moon run workspace:format",
    "format:check": "moon run workspace:format-check",
    "lint": "moon run :lint",
    "prepare": "husky",
    "test": "moon run :test",
    "typecheck": "moon run :typecheck",
    "check": "moon run --concurrency 4 :typecheck :lint :test",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:check": "moon run workspace:changeset-check --",
    "release:version": "moon run workspace:version",
    "publish:dry-run": "moon run workspace:publish-dry-run --",
    "release": "moon run workspace:release-publish --",
    "release:prepare": "moon run workspace:release-prepare --"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@changesets/parse": "catalog:",
    "@changesets/read": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@moonrepo/cli": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@react-native/jest-preset": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-less": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rsbuild/plugin-svgr": "catalog:",
    "@rslib/core": "catalog:",
    "@svgr/core": "catalog:",
    "@svgr/plugin-jsx": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "babel-jest": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "expect-type": "catalog:",
    "husky": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sass": "catalog:",
    "semver": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0",
    "pnpm": "11.6.0"
  },
  "packageManager": "pnpm@11.6.0"
}
