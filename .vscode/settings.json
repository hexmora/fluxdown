{
  "json.schemas": [
    {
      "fileMatch": ["website/docs/**/_meta.json"],
      "url": "./website/node_modules/@rspress/core/meta-json-schema.json"
    },
    {
      "fileMatch": ["website/docs/**/_nav.json"],
      "url": "./website/node_modules/@rspress/core/nav-json-schema.json"
    }
  ],
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.lint.run": "onType",
  "oxc.enable.oxfmt": true,
  "oxc.fixKind": "safe_fix_or_suggestion",
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always",
    "source.removeUnusedImports": "always"
  }
}
