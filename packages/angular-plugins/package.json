{
  "name": "@fluxdown/angular-plugins",
  "version": "0.2.0",
  "description": "Angular render slots and plugin presets for Fluxdown.",
  "keywords": [
    "angular",
    "hast",
    "markdown",
    "plugins",
    "renderer",
    "streaming"
  ],
  "homepage": "https://hexmora.github.io/fluxdown/",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/angular-plugins"
  },
  "files": [
    "dist/fesm2022",
    "dist/types",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.less"
  ],
  "exports": {
    "./base": "./src/base/index.ts",
    "./typings": "./src/typings/index.ts",
    "./full": "./src/presets/full/index.ts",
    "./lite": "./src/presets/lite/index.ts",
    "./plugins/blockquote": "./src/plugins/blockquote/index.ts",
    "./plugins/break-line": "./src/plugins/break-line/index.ts",
    "./plugins/cjk": "./src/plugins/cjk/index.ts",
    "./plugins/code": "./src/plugins/code/index.ts",
    "./plugins/code-pele": "./src/plugins/code-pele/index.ts",
    "./plugins/code-prism": "./src/plugins/code-prism/index.ts",
    "./plugins/code-shiki": "./src/plugins/code-shiki/index.ts",
    "./plugins/effect-chunk": "./src/plugins/effect-chunk/index.ts",
    "./plugins/effect-scale": "./src/plugins/effect-scale/index.ts",
    "./plugins/effect-shad": "./src/plugins/effect-shad/index.ts",
    "./plugins/effect-suffix": "./src/plugins/effect-suffix/index.ts",
    "./plugins/emoji": "./src/plugins/emoji/index.ts",
    "./plugins/emphasis": "./src/plugins/emphasis/index.ts",
    "./plugins/fallback": "./src/plugins/fallback/index.ts",
    "./plugins/heading": "./src/plugins/heading/index.ts",
    "./plugins/image": "./src/plugins/image/index.ts",
    "./plugins/link": "./src/plugins/link/index.ts",
