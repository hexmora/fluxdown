{
  "name": "@fluxdown/react-base-presets",
  "version": "0.1.0",
  "description": "Shared platform-independent React render plugins and slot infrastructure for Fluxdown.",
  "keywords": [
    "hast",
    "markdown",
    "plugins",
    "react",
    "renderer",
    "streaming"
  ],
  "homepage": "https://github.com/hexmora/fluxdown/tree/main/packages/react-base-presets#readme",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/react-base-presets"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./base": "./src/base/index.ts",
    "./render": "./src/render/index.ts",
    "./math": {
      "types": "./src/math/index.ts",
      "react-native": "./dist/esm/math.js",
      "default": "./src/math/index.ts"
    },
    "./typings": "./src/typings/index.ts",
    "./highlight": "./src/highlight/index.ts",
    "./plugins/*": "./src/plugins/*/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./base": {
        "import": {
          "types": "./dist/esm/base/index.d.ts",
          "default": "./dist/esm/base.js"
        },
        "require": {
          "types": "./dist/cjs/base/index.d.cts",
          "default": "./dist/cjs/base.cjs"
        }
      },
      "./render": {
        "import": {
          "types": "./dist/esm/render/index.d.ts",
          "default": "./dist/esm/render.js"
        },
        "require": {
          "types": "./dist/cjs/render/index.d.cts",
          "default": "./dist/cjs/render.cjs"
        }
      },
      "./math": {
        "import": {
          "types": "./dist/esm/math/index.d.ts",
          "default": "./dist/esm/math.js"
        },
        "require": {
          "types": "./dist/cjs/math/index.d.cts",
          "default": "./dist/cjs/math.cjs"
        }
      },
      "./typings": {
        "import": {
          "types": "./dist/esm/typings/index.d.ts"
        },
        "require": {
          "types": "./dist/cjs/typings/index.d.cts"
        }
      },
      "./highlight": {
        "import": {
          "types": "./dist/esm/highlight/index.d.ts",
          "default": "./dist/esm/highlight.js"
        },
        "require": {
          "types": "./dist/cjs/highlight/index.d.cts",
          "default": "./dist/cjs/highlight.cjs"
        }
      },
      "./plugins/*": {
        "import": {
          "types": "./dist/esm/plugins/*/index.d.ts",
          "browser": "./dist/esm/plugins/*.browser.js",
          "default": "./dist/esm/plugins/*.js"
        },
        "require": {
          "types": "./dist/cjs/plugins/*/index.d.cts",
          "browser": "./dist/cjs/plugins/*.browser.cjs",
          "default": "./dist/cjs/plugins/*.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects react-base-presets --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-presets": "workspace:^",
    "@fluxdown/types": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "@mathjax/mathjax-tex-font": "catalog:",
    "@mathjax/src": "catalog:",
    "@types/hast": "catalog:",
    "lodash-es": "catalog:",
    "react-error-boundary": "catalog:",
    "shallow-equal": "catalog:",
    "shiki": "catalog:",
    "stative": "workspace:^"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "expect-type": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react-peer"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
