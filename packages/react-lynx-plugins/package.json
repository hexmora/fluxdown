{
  "name": "@fluxdown/react-lynx-plugins",
  "version": "0.4.0",
  "description": "React Lynx elements and render plugins for Fluxdown.",
  "homepage": "https://fluxdown.dev/",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/react-lynx-plugins"
  },
  "files": [
    "dist/esm",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/plugins/code-prism/slot/code-prism/renderer/languages.ts",
    "./src/plugins/code-prism/slot/code-prism/renderer/runtime.ts",
    "./dist/esm/plugins/code-prism/slot/code-prism/renderer/languages.jsx",
    "./dist/esm/plugins/code-prism/slot/code-prism/renderer/runtime.jsx"
  ],
  "exports": {
    "./typings": "./src/typings/index.ts",
    "./base": "./src/base/index.ts",
    "./plugins/*": "./src/plugins/*/index.ts",
    "./*": "./src/presets/*/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./typings": {
        "types": "./dist/esm/typings/index.d.ts"
      },
      "./base": {
        "types": "./dist/esm/base/index.d.ts",
        "default": "./dist/esm/base/index.jsx"
      },
      "./plugins/*": {
        "types": "./dist/esm/plugins/*/index.d.ts",
        "default": "./dist/esm/plugins/*/index.jsx"
      },
      "./*": {
        "types": "./dist/esm/presets/*/index.d.ts",
        "default": "./dist/esm/presets/*/index.jsx"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "rstest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-plugins": "workspace:^",
    "@fluxdown/hast": "workspace:^",
    "@fluxdown/types": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "@types/hast": "catalog:",
    "core-js": "catalog:",
    "lodash-es": "catalog:",
    "mathjax-full": "catalog:",
    "prismjs": "catalog:",
    "shallow-equal": "catalog:",
    "shiki": "catalog:lynx-shiki",
    "stative": "workspace:^"
  },
  "devDependencies": {
    "@lynx-js/react": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rslib/core": "catalog:",
    "@rstest/adapter-rslib": "catalog:",
    "@rstest/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/prismjs": "catalog:",
    "@types/react": "catalog:",
    "expect-type": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@lynx-js/react": "catalog:lynx-peer",
    "@lynx-js/types": "catalog:lynx-peer",
    "@types/react": "^18 || ^19"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
