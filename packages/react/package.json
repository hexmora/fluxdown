{
  "name": "fluxdown",
  "version": "0.13.0",
  "description": "React wrapper around @fluxdown/core for high-performance rendering of streaming Markdown text.",
  "keywords": [
    "hast",
    "llm",
    "markdown",
    "react",
    "renderer",
    "streaming"
  ],
  "homepage": "https://hexmora.github.io/fluxdown/",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/react"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "**/*.scss",
    "./dist/esm/*.browser.js",
    "./dist/cjs/*.browser.cjs"
  ],
  "main": "./src/packs/full/index.tsx",
  "module": "./src/packs/full/index.tsx",
  "types": "./src/packs/full/index.tsx",
  "exports": {
    ".": "./src/packs/full/index.tsx",
    "./*": "./src/packs/*/index.tsx",
    "./styles.css": "./dist/esm/styles.css"
  },
  "publishConfig": {
    "main": "./dist/cjs/full.cjs",
    "module": "./dist/esm/full.browser.js",
    "types": "./dist/esm/packs/full/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/packs/full/index.d.ts",
          "browser": "./dist/esm/full.browser.js",
          "node": "./dist/esm/full.js",
          "default": "./dist/esm/full.browser.js"
        },
        "require": {
          "types": "./dist/cjs/packs/full/index.d.cts",
          "browser": "./dist/cjs/full.browser.cjs",
          "node": "./dist/cjs/full.cjs",
          "default": "./dist/cjs/full.browser.cjs"
        }
      },
      "./styles.css": "./dist/esm/styles.css",
      "./*": {
        "import": {
          "types": "./dist/esm/packs/*/index.d.ts",
          "browser": "./dist/esm/*.browser.js",
          "node": "./dist/esm/*.js",
          "default": "./dist/esm/*.browser.js"
        },
        "require": {
          "types": "./dist/cjs/packs/*/index.d.cts",
          "browser": "./dist/cjs/*.browser.cjs",
          "node": "./dist/cjs/*.cjs",
          "default": "./dist/cjs/*.browser.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006",
    "build": "rslib build",
    "build:storybook": "storybook build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects react --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/react-base": "workspace:^",
    "@fluxdown/react-base-plugins": "workspace:^",
    "@fluxdown/react-plugins": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "classnames": "catalog:",
    "lodash-es": "catalog:",
    "shallow-equal": "catalog:"
  },
  "devDependencies": {
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-plugins": "workspace:^",
    "@fluxdown/types": "workspace:^",
    "@rslib/core": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/hast": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "expect-type": "catalog:",
    "less": "catalog:",
    "oxlint": "catalog:",
    "react-use": "catalog:",
    "sass": "catalog:",
    "stative": "workspace:^",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react-peer",
    "react-dom": "catalog:react-peer"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
