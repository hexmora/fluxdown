{
  "name": "@fluxdown/react-base-plugins",
  "version": "0.11.0",
  "description": "Platform-independent React render plugins and slot infrastructure for Fluxdown.",
  "keywords": [
    "hast",
    "markdown",
    "plugins",
    "react",
    "renderer",
    "streaming"
  ],
  "homepage": "https://hexmora.github.io/fluxdown/",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/react-base-plugins"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./typings": "./src/typings/index.ts",
    "./base": "./src/base/index.ts",
    "./plugins/*": "./src/plugins/*/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./typings": {
        "import": {
          "types": "./dist/esm/typings/index.d.ts"
        },
        "require": {
          "types": "./dist/cjs/typings/index.d.cts"
        }
      },
      "./base": {
        "import": {
          "types": "./dist/esm/base/index.d.ts",
          "default": "./dist/esm/base.js"
        },
        "require": {
          "types": "./dist/cjs/base/index.d.cts",
          "default": "./dist/cjs/base.cjs"
        }
      },
      "./plugins/*": {
        "import": {
          "types": "./dist/esm/plugins/*/index.d.ts",
          "default": "./dist/esm/plugins/*.js"
        },
        "require": {
          "types": "./dist/cjs/plugins/*/index.d.cts",
          "default": "./dist/cjs/plugins/*.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects react-base-plugins --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-plugins": "workspace:^",
    "@fluxdown/react-hooks": "workspace:^",
    "@fluxdown/types": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "@types/hast": "catalog:",
    "lodash-es": "catalog:",
    "react-error-boundary": "catalog:",
    "shallow-equal": "catalog:",
    "stative": "workspace:^"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "expect-type": "catalog:",
    "oxlint": "catalog:",
    "react-dom": "catalog:react-peer",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react-peer"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
