{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "path": "../../.angular/cache"
    }
  },
  "projects": {
    "angular": {
      "projectType": "library",
      "root": ".",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "ng-package.json",
            "tsConfig": "tsconfig.build.json"
          }
        },
        "test-build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": ".storybook/app.ts",
            "index": ".storybook/index.html",
            "tsConfig": "tsconfig.storybook.json",
            "outputPath": "../../.angular/testing",
            "polyfills": []
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "angular:test-build:development",
            "tsConfig": "tsconfig.spec.json",
            "runnerConfig": "vitest.config.ts"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular:test-build:development",
            "tsConfig": "tsconfig.storybook.json",
            "port": 6011,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular:test-build:development",
            "tsConfig": "tsconfig.storybook.json",
            "outputDir": "storybook-static",
            "compodoc": false
          }
        }
      }
    },
    "angular-plugins": {
      "projectType": "library",
      "root": "../angular-plugins",
      "sourceRoot": "../angular-plugins/src",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "angular:test-build:development",
            "tsConfig": "../angular-plugins/tsconfig.spec.json",
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  }
}
