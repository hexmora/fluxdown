<script setup lang="ts">
import { computed } from 'vue';

import type { InlinePartProps } from './type';

import { EASE_OUT } from '../../../../animation/easing';
import { useAppear } from '../../../../animation/hooks';
import { ScaleText } from '../../../scale-text';

const props = defineProps<InlinePartProps>();

const scale = computed(() =>
  props.node.effect?.type === 'scale'
    ? props.node.effect
    : { start: -1, duration: 0, from: 1, blur: 0 },
);

const progress = useAppear(() => {
  const effect = props.node.effect;

  return effect?.type === 'chunk' ? effect : { start: -1, duration: 0 };
});

const style = computed(() => ({
  ...props.textStyle,
  opacity: EASE_OUT(progress.value) * Number(props.textStyle.opacity ?? 1),
}));
</script>

<template>
  <ScaleText
    :text="props.node.text"
    :text-style="style"
    :start="scale.start"
    :duration="scale.duration"
    :from="scale.from"
    :blur="scale.blur"
  />
</template>
