<script setup lang="ts">
import { computed } from 'vue';

import type { RendererProps } from './type';

import InheritedText from '../../../../../base/components/inherited-text/index.uvue';
import InlineCanvas from '../../../../../base/components/inline-canvas/index.uvue';
import { isTextNode } from '../../../../../base/slot/components/render-nodes/utils';

const props = defineProps<RendererProps>();

const text = computed(() => (props.children?.every(isTextNode) ? props.children.join('') : null));
</script>

<template>
  <InheritedText v-slot="{ textStyle, attributes }">
    <InlineCanvas
      v-if="text !== null"
      v-bind="attributes"
      :text="text"
      :text-style="textStyle"
      :start="props.start"
      :duration="props.duration"
      :from="props.from"
      :blur="props.blur"
    />
    <slot v-else />
  </InheritedText>
</template>
