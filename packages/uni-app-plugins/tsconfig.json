{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals",
      "@dcloudio/uni-app-x/types/native/global",
      "@dcloudio/uni-app-x/types/uni/global"
    ],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "ignoreDeprecations": "6.0",
    "jsx": "preserve"
  },
  "vueCompilerOptions": {
    "extensions": [".vue", ".uvue"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "vitest.setup.ts"]
}
