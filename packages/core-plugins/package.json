{
  "name": "@fluxdown/core-plugins",
  "version": "0.12.3",
  "description": "Headless preset mapper, remark, rehype, and repair plugins for Fluxdown.",
  "keywords": [
    "headless",
    "markdown",
    "plugins",
    "rehype",
    "remark",
    "unified"
  ],
  "homepage": "https://hexmora.github.io/fluxdown/",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/core-plugins"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./plugins/mapper/*": "./src/plugins/mapper/*/index.tsx",
    "./plugins/rehype/*": "./src/plugins/rehype/*/index.ts",
    "./plugins/remark/*": "./src/plugins/remark/*/index.ts",
    "./plugins/repair/*": "./src/plugins/repair/*/index.ts",
    "./presets/*": "./src/presets/*/index.ts",
    "./typings": "./src/typings/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./plugins/*": {
        "import": {
          "types": "./dist/esm/plugins/*/index.d.ts",
          "default": "./dist/esm/plugins/*.js"
        },
        "require": {
          "types": "./dist/cjs/plugins/*/index.d.cts",
          "default": "./dist/cjs/plugins/*/index.cjs"
        }
      },
      "./presets/*": {
        "import": {
          "types": "./dist/esm/presets/*/index.d.ts",
          "default": "./dist/esm/presets/*.js"
        },
        "require": {
          "types": "./dist/cjs/presets/*/index.d.cts",
          "default": "./dist/cjs/presets/*/index.cjs"
        }
      },
      "./typings": {
        "import": {
          "types": "./dist/esm/typings/index.d.ts"
        },
        "require": {
          "types": "./dist/cjs/typings/index.d.cts"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects core-plugins --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/hast": "workspace:^",
    "@fluxdown/mdast": "workspace:^",
    "@fluxdown/types": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "hast-util-sanitize": "catalog:",
    "lodash-es": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm-autolink-literal": "catalog:",
    "mdast-util-gfm-footnote": "catalog:",
    "mdast-util-gfm-strikethrough": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "mdast-util-gfm-task-list-item": "catalog:",
    "mdast-util-math": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark-extension-cjk-friendly": "catalog:",
    "micromark-extension-cjk-friendly-gfm-strikethrough": "catalog:",
    "micromark-extension-gfm-autolink-literal": "catalog:",
    "micromark-extension-gfm-footnote": "catalog:",
    "micromark-extension-gfm-strikethrough": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "micromark-extension-gfm-task-list-item": "catalog:",
    "micromark-extension-math": "catalog:",
    "micromark-util-character": "catalog:",
    "micromark-util-types": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-breaks": "catalog:",
    "remark-gemoji": "catalog:",
    "rxjs": "catalog:",
    "shallow-equal": "catalog:",
    "stative": "workspace:^",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "expect-type": "catalog:",
    "oxlint": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
