{
  "name": "@fluxdown/vue-lynx",
  "version": "0.2.0",
  "description": "Streaming Markdown renderer for Vue Lynx AI chat, with native elements, syntax repair, and smooth output.",
  "keywords": [
    "ai-chat",
    "llm",
    "lynx",
    "markdown",
    "markdown-renderer",
    "streaming",
    "streaming-markdown",
    "vue"
  ],
  "homepage": "https://fluxdown.dev/guide/vue-lynx/quick-start.html",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/vue-lynx"
  },
  "files": [
    "dist/esm",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./src/packs/full/index.tsx",
  "module": "./src/packs/full/index.tsx",
  "types": "./src/packs/full/index.tsx",
  "exports": {
    ".": "./src/packs/full/index.tsx",
    "./full": "./src/packs/full/index.tsx",
    "./lite": "./src/packs/lite/index.tsx",
    "./raw": "./src/packs/raw/index.tsx"
  },
  "publishConfig": {
    "main": "./dist/esm/packs/full/index.js",
    "module": "./dist/esm/packs/full/index.js",
    "types": "./dist/esm/packs/full/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/esm/packs/full/index.d.ts",
        "default": "./dist/esm/packs/full/index.js"
      },
      "./full": {
        "types": "./dist/esm/packs/full/index.d.ts",
        "default": "./dist/esm/packs/full/index.js"
      },
      "./lite": {
        "types": "./dist/esm/packs/lite/index.d.ts",
        "default": "./dist/esm/packs/lite/index.js"
      },
      "./raw": {
        "types": "./dist/esm/packs/raw/index.d.ts",
        "default": "./dist/esm/packs/raw/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source",
    "dev": "pnpm run build:preview && storybook dev -p 6013 --no-open",
    "storybook": "pnpm run dev",
    "build:preview": "tsx stories/build.ts",
    "build:storybook": "pnpm run build:preview && storybook build"
  },
  "dependencies": {
    "@fluxdown/utils": "workspace:^",
    "@fluxdown/vue-base": "workspace:^",
    "@fluxdown/vue-base-plugins": "workspace:^",
    "@fluxdown/vue-lynx-plugins": "workspace:^",
    "core-js": "catalog:"
  },
  "devDependencies": {
    "@lynx-js/lynx-core": "catalog:",
    "@lynx-js/rspeedy": "catalog:",
    "@lynx-js/types": "catalog:",
    "@lynx-js/web-core": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-babel": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rsbuild/plugin-vue": "catalog:",
    "@rsbuild/plugin-vue-jsx": "catalog:",
    "@rslib/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/hast": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "expect-type": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "storybook": "catalog:",
    "storybook-lynx-rsbuild": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-lynx": "catalog:"
  },
  "peerDependencies": {
    "@lynx-js/types": "catalog:lynx-peer",
    "vue": "catalog:vue-peer",
    "vue-lynx": "catalog:vue-lynx-peer"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
