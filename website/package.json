{
  "name": "@fluxdown/website",
  "version": "0.0.17",
  "private": true,
  "homepage": "https://fluxdown.dev/",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:renderers && rspress dev --host 127.0.0.1",
    "build": "pnpm run build:renderers && rspress build",
    "preview": "rspress preview --host 127.0.0.1",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run check:seo",
    "check:seo": "tsx seo/check.ts",
    "lint": "oxlint .",
    "typecheck": "pnpm run build:renderers && tsc --noEmit && tsc --noEmit -p react-lynx/tsconfig.json && tsc --noEmit -p vue-lynx/tsconfig.json",
    "build:renderers": "pnpm --filter @fluxdown/vue-base-plugins --filter @fluxdown/vue-base --filter @fluxdown/vue-plugins --filter @fluxdown/vue --filter @fluxdown/solid-plugins --filter @fluxdown/solid build && pnpm --workspace-root exec moon run angular:build",
    "benchmark:repair": "node scripts/benchmark-repair/index.mjs"
  },
  "dependencies": {
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@fluxdown/angular": "workspace:^",
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-plugins": "workspace:^",
    "@fluxdown/react-native": "workspace:^",
    "@fluxdown/react-native-plugins": "workspace:^",
    "@fluxdown/react-plugins": "workspace:^",
    "@fluxdown/solid": "workspace:^",
    "@fluxdown/svelte": "workspace:^",
    "@fluxdown/taro": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "@fluxdown/vue": "workspace:^",
    "@tarojs/components": "catalog:",
    "@tarojs/taro": "catalog:",
    "fluxdown": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "rxjs": "catalog:",
    "solid-js": "catalog:",
    "stative": "workspace:^",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@angular/compiler-cli": "catalog:",
    "@ant-design/x-markdown": "catalog:benchmark-repair",
    "@babel/core": "catalog:",
    "@fluxdown/react-lynx": "workspace:^",
    "@fluxdown/types": "workspace:^",
    "@fluxdown/vue-lynx": "workspace:^",
    "@lynx-js/react": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@lynx-js/rspeedy": "catalog:",
    "@lynx-js/types": "catalog:",
    "@lynx-js/web-core": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-babel": "catalog:",
    "@rsbuild/plugin-less": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rsbuild/plugin-svelte": "catalog:",
    "@rsbuild/plugin-svgr": "catalog:",
    "@rsbuild/plugin-vue-jsx": "catalog:",
    "@rspress/core": "catalog:",
    "@tarojs/components-react": "catalog:",
    "@tarojs/taro-h5": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-loader": "catalog:",
    "esbuild": "catalog:benchmark-repair",
    "jsdom": "catalog:",
    "less": "catalog:",
    "markdown-it": "catalog:benchmark-repair",
    "markdown-it-task-lists": "catalog:benchmark-repair",
    "marked": "catalog:benchmark-repair",
    "oxlint": "catalog:",
    "react-markdown": "catalog:benchmark-repair",
    "remark-gfm": "catalog:benchmark-repair",
    "sass": "catalog:",
    "streamdown": "catalog:benchmark-repair",
    "typescript": "catalog:angular",
    "vue-lynx": "catalog:"
  }
}
