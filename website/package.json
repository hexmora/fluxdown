{
  "name": "@fluxdown/website",
  "version": "0.0.12",
  "private": true,
  "homepage": "https://hexmora.github.io/fluxdown/",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:renderers && rspress dev --host 127.0.0.1",
    "build": "pnpm run build:renderers && rspress build",
    "preview": "rspress preview --host 127.0.0.1",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build",
    "lint": "oxlint .",
    "typecheck": "pnpm run build:renderers && tsc --noEmit && tsc --noEmit -p lynx/tsconfig.json",
    "build:renderers": "pnpm --filter @fluxdown/vue-plugins --filter @fluxdown/vue --filter @fluxdown/solid-plugins --filter @fluxdown/solid build"
  },
  "dependencies": {
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-plugins": "workspace:^",
    "@fluxdown/react-native": "workspace:^",
    "@fluxdown/react-native-plugins": "workspace:^",
    "@fluxdown/react-plugins": "workspace:^",
    "@fluxdown/solid": "workspace:^",
    "@fluxdown/svelte": "workspace:^",
    "@fluxdown/taro": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "@fluxdown/vue": "workspace:^",
    "@tarojs/components": "catalog:",
    "@tarojs/taro": "catalog:",
    "fluxdown": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "solid-js": "catalog:",
    "stative": "workspace:^",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@fluxdown/lynx": "workspace:^",
    "@lynx-js/react": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@lynx-js/types": "catalog:",
    "@lynx-js/web-core": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-less": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rsbuild/plugin-svelte": "catalog:",
    "@rsbuild/plugin-svgr": "catalog:",
    "@rspress/core": "catalog:",
    "@tarojs/components-react": "catalog:",
    "@tarojs/taro-h5": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "less": "catalog:",
    "oxlint": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:"
  }
}
