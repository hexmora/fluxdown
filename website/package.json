{
  "name": "@fluxdown/website",
  "version": "0.0.2",
  "private": true,
  "homepage": "https://hexmora.github.io/fluxdown/",
  "type": "module",
  "scripts": {
    "dev": "rspress dev --host 127.0.0.1",
    "build": "rspress build",
    "preview": "rspress preview --host 127.0.0.1",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxdown/core": "workspace:^",
    "@fluxdown/core-presets": "workspace:^",
    "@fluxdown/react-presets": "workspace:^",
    "@fluxdown/utils": "workspace:^",
    "fluxdown": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stative": "workspace:^"
  },
  "devDependencies": {
    "@rsbuild/plugin-less": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rsbuild/plugin-svgr": "catalog:",
    "@rspress/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "less": "catalog:",
    "oxlint": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:"
  }
}
